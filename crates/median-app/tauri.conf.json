{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Median Dev",
  "mainBinaryName": "Median",
  "version": "0.0.0",
  "identifier": "com.median.dev",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1421",
    "frontendDist": "dist"
  },
  "app": {
    "windows": [
      {
        "label": "launcher",
        "url": "launcher.html",
        "title": "Median",
        "width": 440,
        "height": 280,
        "center": true,
        "decorations": false,
        "resizable": false,
        "create": false
      },
      {
        "label": "main",
        "title": "Median",
        "width": 1440,
        "height": 810,
        "minWidth": 1152,
        "minHeight": 648,
        "center": true,
        "decorations": false,
        "visible": false,
        "create": false
      },
      {
        "label": "overlay",
        "url": "overlay.html",
        "create": false,
        "title": "Median overlay",
        "width": 1920,
        "height": 1080,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "contentProtected": false,
        "focus": false,
        "focusable": false,
        "resizable": false,
        "shadow": false,
        "skipTaskbar": true,
        "visible": false
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "windows": { "nsis": { "installMode": "currentUser" } }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVDODk3NDI0Qjc0MDJDN0YKUldSL0xFQzNKSFNKN0Q0RVREWjVRZ2xoeGVHUm1jQXJnVWdhNHBaUitsWGEvRDE0cGVWRmdsTVUK",
      "windows": { "installMode": "passive" }
    }
  }
}
